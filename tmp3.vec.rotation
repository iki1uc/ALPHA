export const TMP_VEC_ROTATION = {
  id: "tmp3.vec.rotation",
  mode: "alpha-vec-rotation",
  status: "active",

  rotation(entry) {
    return {
      entry,
      vector: this.vector(entry),
      axis: this.axis(entry),
      respo: this.respo(entry),
      color: this.color(entry),
      percent: this.percent(entry),
      degree: this.degree(entry),
      rotation: this.spin(entry),
      rotated: true
    };
  },

  vector(entry) {
    if (entry.includes("markt")) return "VEC-MARKT";
    if (entry.includes("infra")) return "VEC-INFRA";
    if (entry.includes("prod")) return "VEC-PROD";
    if (entry.includes("layer")) return "VEC-LAYER";
    return "VEC-ROOT";
  },

  axis(entry) {
    if (entry.includes("markt")) return "Y";
    if (entry.includes("infra")) return "Z";
    if (entry.includes("prod")) return "X";
    if (entry.includes("layer")) return "T";
    return "O";
  },

  respo(entry) {
    if (entry.includes("gewinn")) return "OK";
    if (entry.includes("verlust")) return "NOK";
    if (entry.includes("fluss")) return "FLOW";
    if (entry.includes("stop")) return "BREAK";
    if (entry.includes("echo")) return "ECHO";
    if (entry.includes("void")) return "VOID";
    return "ROOT";
  },

  color(entry) {
    const r = this.respo(entry);
    return r === "OK" || r === "ROOT" ? "green"
         : r === "FLOW" || r === "ECHO" ? "yellow"
         : "red";
  },

  percent(entry) {
    return entry.includes("gewinn") ? "100%" : "50%";
  },

  degree(entry) {
    return entry.includes("rotation") ? "360°" : "180°";
  },

  spin(entry) {
    if (entry.includes("rum")) return "rumHERum";
    if (entry.includes("kreis")) return "360°";
    return "180°";
  }
};
vector(entry) {
  if (entry.includes("uni")) return "VEC-UNI";
  if (entry.includes("welt")) return "VEC-WELT";
  if (entry.includes("ort")) return "VEC-ORT";
  if (entry.includes("home")) return "VEC-HOME";
  ...
}
axis(entry) {
  if (entry.includes("uni")) return "U";
  if (entry.includes("welt")) return "W";
  if (entry.includes("ort")) return "O";
  if (entry.includes("home")) return "H";
  ...
}
if (entry.includes("uni")) factor *= 3;
if (entry.includes("welt")) factor *= 2;
if (entry.includes("ort")) factor *= 1.5;
if (entry.includes("home")) factor *= 1.2;
