import CYCLE from "./c.tmp";

export const NC_ENGINE = {
  id: "nc.engine",
  operator: CYCLE.operator,   // "C"
  mode: CYCLE.mode,           // "cycle"
  value: CYCLE.value,         // 2

  // NET / LINK / DIRECT / SPO
  net: "enabled",
  link: "direct",
  direct: true,
  spo: "continuum",

  // SLIDE / WETTE
  slide(entry) {
    return entry.includes("slide") ? 1.5 : 1.0;
  },

  wette(entry) {
    return entry.includes("wette") ? 2.0 : 1.0;
  },

  // Gesamtfaktor
  factor(entry) {
    return this.value * this.slide(entry) * this.wette(entry);
  }
};
